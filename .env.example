# Base URL where your Lidarr instance is reachable from this container.
# If deployed in the same Dokploy project/network as Lidarr, you can usually
# use the internal service name instead of an IP, e.g. http://lidarr:8686
LIDARR_URL=http://lidarr:8686

# Settings > General > Security > API Key in Lidarr
LIDARR_API_KEY=your-lidarr-api-key

# Port the web dashboard listens on inside the container
PORT=8080

# Name of the existing Docker network your Jellyfin/Lidarr stack runs on.
# Only needed if you're deploying this with docker-compose.yml as a
# separate stack alongside your existing one. See README for how to find it.
LIDARR_NETWORK=your-existing-network-name
